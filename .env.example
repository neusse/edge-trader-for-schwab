# Edge Trader: copy this file to .env and fill in the selected broker's credentials.
# .env is never committed.

# Alpaca Paper is the default broker. Use paper keys only; live Alpaca is not supported.
alpaca_paper_api_key=
alpaca_paper_secret=
# Optional fixed paper endpoint (other endpoints are rejected):
# alpaca_paper_endpoint=https://paper-api.alpaca.markets

# Schwab is selectable in the app. Get values at https://developer.schwab.com.

# Your app's App Key and Secret
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the Callback URL registered on your Schwab app exactly
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Optional: where the Schwab tokens are kept (default ~/.schwabdev/tokens.db)
# SCHWAB_TOKENS_DB=
# Optional: read the keys from another app's .env instead (to share one Schwab login)
# SCHWAB_ENV_FILE=
# Optional: the local port (default 8770)
# COMPANION_PORT=8770
# Optional: set to 1 to turn off the once-a-day check for a newer release on GitHub
# EDGE_TRADER_NO_UPDATE_CHECK=
